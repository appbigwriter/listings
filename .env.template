# Authentication (required for mutable APIs)
# trusted-gateway verifies HMAC headers from an authenticated gateway.
PRELISTING_AUTH_MODE=trusted-gateway
AUTH_GATEWAY_SECRET=replace-with-runtime-secret
# Development only: fixed identity; never present as production auth.
# PRELISTING_AUTH_MODE=local-only
# PRELISTING_ALLOW_LOCAL_ONLY=true
# PRELISTING_LOCAL_USER_ID=e2e-user
# PRELISTING_LOCAL_ORG_ID=e2e-org

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL — Project Settings > Database > Connection string > Session pooler
# Use only for migrations/SQL clients. Never expose this to the browser.
DATABASE_URL=postgresql://postgres.PROJECT_REF:***@aws-REGION.pooler.supabase.com:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXTRACTION_MAX_BYTES=2000000
