# Authentication (required for mutable APIs)
# trusted-gateway verifies HMAC headers from an authenticated gateway.
PRELISTING_AUTH_MODE=trusted-gateway
AUTH_GATEWAY_SECRET=replace-with-runtime-secret
# Development only: fixed identity; never present as production auth.
# PRELISTING_AUTH_MODE=local-only
# PRELISTING_ALLOW_LOCAL_ONLY=true
# PRELISTING_LOCAL_USER_ID=e2e-user
# PRELISTING_LOCAL_ORG_ID=e2e-org

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL — Project Settings > Database > Connection string > Session pooler
# Use only for migrations/SQL clients. Never expose this to the browser.
DATABASE_URL=postgresql://postgres.PROJECT_REF:***@aws-REGION.pooler.supabase.com:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXTRACTION_MAX_BYTES=2000000

# Catalog source — read-only store credentials, separate from the PreListing DB
FBR_SOURCE_SUPABASE_URL=
FBR_SOURCE_SUPABASE_ANON_KEY=
# Alternative JSON source (HTTPS host must be allowlisted)
SOURCE_CATALOG_URL=
SOURCE_CATALOG_ALLOWED_HOSTS=
SOURCE_CATALOG_TOKEN=

# AI — all keys stay on the server
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Stable approval signing secret; fallback is the server-only service role key.
# Rotating either signing key requires approving existing versions again.
PRELISTING_REVIEW_SECRET=

# Amazon US SP-API / Login With Amazon
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_SELLER_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-na.amazon.com
# Keep disabled until an explicit publication decision
PRELISTING_ENABLE_PUBLICATION=false

# Preparation adapters; publishing to these channels is not enabled
EBAY_ACCESS_TOKEN=
WALMART_ACCESS_TOKEN=
WALMART_SPEC_VERSION=
WALMART_FEED_TYPE=MP_ITEM
WALMART_CONSUMER_CHANNEL_TYPE=
