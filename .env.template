# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL — Project Settings > Database > Connection string > Session pooler
# Use only for migrations/SQL clients. Never expose this to the browser.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: max HTML bytes fetched by the extraction API
EXTRACTION_MAX_BYTES=2000000
